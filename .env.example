# 复制成 .env 后按需修改（settings.py 会自动读取，不需要 export）

# —— 基本 ——
ASIANARK_SECRET_KEY=change-me-in-production
ASIANARK_DEBUG=1
ASIANARK_ALLOWED_HOSTS=localhost,127.0.0.1

# —— 数据库 ——
# sqlite = 本地开发（默认）。建表：python manage.py init_local_db
# mysql  = 线上老库 bjl（表结构已存在，Django 不碰）
ASIANARK_DB=sqlite
ASIANARK_SQLITE_PATH=bjl.sqlite3
ASIANARK_DB_NAME=bjl
ASIANARK_DB_USER=web
ASIANARK_DB_PASSWORD=
ASIANARK_DB_HOST=202.77.29.210
ASIANARK_DB_PORT=3306

# —— 游戏服 HTTP 推送 ——
ASIANARK_GAME_SERVER_URL=202.77.29.210
ASIANARK_GAME_SERVER_PORT=2012
ASIANARK_GAME_SERVER_TIMEOUT=3
ASIANARK_PUSH_ENABLED=1

# —— firefly memcache（t_video / t_table 的内存模型同步）——
ASIANARK_MEMCACHE_LOCATION=127.0.0.1:11211
ASIANARK_MEMCACHE_HOSTNAME=bjl
ASIANARK_MEMCACHE_ENABLED=0

# —— 后台首页看板的缓存秒数 ——
ASIANARK_DASHBOARD_CACHE=60
